{
  "name": "woco",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "npm run dev -w @woco/web",
    "dev:server": "npm run dev -w @woco/server",
    "test:shared": "npm test -w @woco/shared",
    "test:server": "npm test -w @woco/server",
    "build:web": "npm run build -w @woco/web",
    "build:server": "npm run build -w @woco/server",
    "build:embed": "npm run build -w @woco/embed",
    "build:deploy": "node scripts/installed-deps.cjs && npm run build:web",
    "build:site": "node scripts/installed-deps.cjs && npm run build:site -w @woco/web",
    "build:multisite": "node scripts/installed-deps.cjs && npm run build:multisite -w @woco/web",
    "build:registry": "npm run build -w @woco/registry",
    "dev:registry": "npm run dev -w @woco/registry",
    "upload:swarm": "node scripts/upload-to-swarm-feed.cjs",
    "upload:site": "node scripts/upload-site-to-swarm.cjs",
    "deploy": "npm run build:deploy && npm run upload:swarm && npm run deploy:scanner",
    "check": "npm run check --workspaces --if-present",
    "build:scanner": "node scripts/installed-deps.cjs && npm run build:scanner -w @woco/web",
    "build:auth": "node scripts/installed-deps.cjs && npm run build:auth -w @woco/web",
    "dev:auth": "npm run dev:auth -w @woco/web",
    "upload:scanner": "node scripts/upload-scanner-to-swarm.cjs",
    "deploy:scanner": "npm run build:scanner && npm run upload:scanner"
  },
  "devDependencies": {
    "@ethersphere/bee-js": "^11.2.0",
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "tar": "^7.5.22",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "@ethersphere/bee-js": {
      "axios": "0.34.0"
    },
    "@segment/analytics-next": {
      "js-cookie": "^3.0.7"
    },
    "ethjs-unit": {
      "bn.js": "^4.12.3"
    },
    "number-to-bn": {
      "bn.js": "^4.12.3"
    }
  }
}
