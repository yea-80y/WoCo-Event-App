# Production env — copy to .env.production and fill in values
VITE_API_URL=https://events-api.woco-net.com
VITE_GATEWAY_URL=https://gateway.woco-net.com
# Kernel bundler + paymaster. Chain segment AND query are both load-bearing —
# see apps/server/.env.example (ZERODEV_RPC) for why; the two must match.
VITE_ZERODEV_RPC=https://rpc.zerodev.app/api/v3/<project-id>/chain/42161?selfFunded=true
# Web3Auth network — EXACTLY "sapphire_devnet" or "sapphire_mainnet". Anything else
# (unset, misspelled, a stray space) refuses to build and refuses to initialise: the
# network derives every Web3Auth account's key, so it is never defaulted. Flip = #244.
VITE_WEB3AUTH_NETWORK=sapphire_devnet
