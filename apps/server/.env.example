# ─────────────────────────────────────────────────────────────────────────────
# WoCo Events Server — environment configuration
# Copy this file to .env and fill in the values before starting the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Swarm / Bee ──────────────────────────────────────────────────────────────

# URL of your Bee node's API. Point this at whichever Bee node you operate.
# Examples: http://localhost:1633  |  http://bee.internal:1633
BEE_URL=http://localhost:1633

# 64-character hex string identifying the postage batch to stamp uploads with.
# Buy a batch via your Bee node: POST /stamps/<amount>/<depth>
# See: https://docs.ethswarm.org/docs/develop/access-the-swarm/buy-a-stamp-batch
POSTAGE_BATCH_ID=

# ── Feed identity ────────────────────────────────────────────────────────────

# 32-byte (64 hex char) secp256k1 private key.
# This key owns ALL event and ticket feeds — keep it secret, back it up.
# Generate with:  openssl rand -hex 32
FEED_PRIVATE_KEY=

# 32-byte secp256k1 private key that signs the social indexer's own published
# evidence reports (#312) — never user data, which is why it is not the key
# above. Its ADDRESS must match SOCIAL_INDEXER_ADDRESS in packages/shared, or
# clients will read a feed nobody writes. Unset = reports are computed and
# served on request, never published; nothing else changes.
SOCIAL_INDEXER_PRIVATE_KEY=

# Publishing cadence — postage spend policy, not tuning. Defaults: a pass every
# 5 minutes, at most 10 subjects per pass, a full re-check daily, and no
# publishing when the batch has under an hour left.
# SOCIAL_PUBLISH_INTERVAL_MS=300000
# SOCIAL_PUBLISH_MAX_PER_FLUSH=10
# SOCIAL_PUBLISH_SWEEP_MS=86400000
# SOCIAL_PUBLISH_MIN_BATCH_TTL=3600
# SOCIAL_PUBLISH_BOOT_DELAY_MS=600000
# SOCIAL_PUBLISH_MAX_FAILURES=5

# ── Security ─────────────────────────────────────────────────────────────────

# Comma-separated list of frontend hostnames the server will accept session
# delegations from. Must exactly match what the browser sends as the page host.
# Example: devcon8.woco.eth,events.devcon.org,localhost:5173
ALLOWED_HOSTS=

# HMAC key for hashing claimer emails before they land on publicly-readable
# Swarm feeds. Without this, hashes are unsalted SHA-256 and trivially
# reversible via rainbow tables. The server REFUSES TO START if unset.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_HASH_SECRET=

# HMAC key for signing payment quotes (prevents client/server price slippage).
# Required for any event with crypto payments. Without it, /api/payment/quote
# cannot sign and all crypto payment claims will fail.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_QUOTE_SECRET=

# Bearer token for /api/ops/* — the operator surface over the undelivered-email
# ledger, the one store holding buyer plaintext addresses. Not wallet auth:
# platform operations have no identity in the auth model to hang off.
# UNSET MEANS THE ROUTES 404, never that they serve openly. Treat it like
# FEED_PRIVATE_KEY.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPS_TOKEN=

# ── Email provider ───────────────────────────────────────────────────────────

# Which ESP sends. "ses" (Amazon SES — the funded provider) or "resend".
# Defaults to "resend" when unset, NOT "ses": deploying SES code to a VM whose
# env has no AWS credentials would take ticket email down completely, so the
# cutover has to be a deliberate one-line change (and so does the rollback).
#
# Left COMMENTED OUT on purpose. Copying this file verbatim would otherwise
# select SES with the empty credentials below and break all outbound email —
# the exact failure the code default exists to prevent. Uncomment only once
# AWS_* are filled in and the console steps in docs/SES_MIGRATION_HANDOVER.md
# §2 are done.
# EMAIL_PROVIDER=ses

# ── Amazon SES (EMAIL_PROVIDER=ses) ──────────────────────────────────────────

# Region the sending identity is verified in. NO DEFAULT — the provider refuses
# to guess, because guessing us-east-1 would mean every message is rejected.
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Configuration set applied to every send. Required for bounce/complaint events
# to reach SNS at all — without it nothing feeds the suppression list.
SES_CONFIGURATION_SET=woco-events

# Sustained messages/second. Keep BELOW the account's SES quota (14/s as of
# 2026-07-30); the limiter shapes our traffic but SES measures at its edge.
SES_MAX_SEND_RATE=12

# SNS topic ARN(s) carrying SES bounce/complaint events, comma-separated.
# REQUIRED: the webhook fails closed without it. A genuine SNS signature only
# proves Amazon sent the message — any AWS customer can get one by publishing on
# their own topic, so the ARN is what proves it is OUR bounce feed.
SES_SNS_TOPIC_ARN=

# Reject SignatureVersion 1 (SHA1) SNS messages. Set to "true" once the topic is
# configured for v2, which AWS recommends.
SNS_REQUIRE_SIGNATURE_V2=false

# ── Email / marketing (Resend) ───────────────────────────────────────────────

# Resend API key — required while Resend is the primary or the failover target.
RESEND_API_KEY=

# Transactional from-address (ticket confirmations, OTPs). Default: events@woco-net.com
# EMAIL_FROM is the provider-neutral name and is read FIRST; RESEND_FROM is the
# legacy alias, still honoured so the SES cutover needed no rename.
EMAIL_FROM=
RESEND_FROM=

# Marketing from-address — MUST be a SEPARATE subdomain (e.g. news@news.woco-net.com).
# EMAIL_FROM_MARKETING is the provider-neutral name, read first; RESEND_FROM_MARKETING
# is the legacy alias.
#
# THERE IS NO FALLBACK. Unset (or empty, or whitespace) means platform marketing
# broadcasts and marketing test sends are REFUSED with 503, and /api/health shows
# `email.marketingSender.ok: false`. This is deliberate (#96): the old fallback was
# the transactional address above, which put imported cold-list mail on the domain
# that delivers everybody's tickets — and every platform-tier organiser shares that
# one reputation.
#
# Organisers with their OWN verified sending domain are unaffected by this being
# unset. So is transactional email. Event broadcasts to an event's own attendees
# also still send, falling back to EMAIL_FROM on purpose — "the event is cancelled"
# must be sendable whatever state this is in.
#
# The identity must be DKIM-verified with the provider BEFORE this is set: a
# set-but-unverified value passes the config check and is then rejected per message.
EMAIL_FROM_MARKETING=
RESEND_FROM_MARKETING=

# Svix signing secret for the Resend webhook (dashboard → Webhooks → add endpoint
# https://your-server/api/resend/webhook, events: email.bounced, email.complained).
# Signature verification is unconditional: unsigned/bad-sig deliveries are 400d,
# and without this secret set ALL webhook events are acknowledged and DROPPED
# (bounces/complaints won't reach the suppression list until it is configured).
RESEND_WEBHOOK_SECRET=

# Per-organiser marketing emails per rolling 24h (ramp-up guard). Default: 2000
MARKETING_DAILY_CAP=2000

# Physical postal address of the sender, ONE line — required in every commercial
# email by CAN-SPAM §7704(a)(5), and checked for by mailbox providers and by the
# AWS SES production-access review. Marketing sends REFUSE to run without it.
# Use the registered office, never a home address: it is published in every send.
# Example: WoCo Ltd, 71-75 Shelton Street, London, WC2H 9JQ, United Kingdom
MARKETING_POSTAL_ADDRESS=

# Public base URL of this API (no trailing slash) — used to build the /t ticket
# links AND the /u unsubscribe links. Marketing sends REFUSE to run without it.
# Example: https://events-api.woco-net.com
PUBLIC_API_BASE=

# ── Stripe (optional — only needed if you enable card payments) ───────────────

# Your Stripe secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# Signing secret for connect-account webhook events (checkout.session.completed).
# Create a webhook endpoint in your Stripe dashboard → Webhooks → Add endpoint.
# URL: https://your-server/api/stripe/webhook  Events: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Signing secret for platform-level webhook events (account.updated).
# Create a separate webhook endpoint for platform events.
STRIPE_WEBHOOK_SECRET_PLATFORM=

# ── Server ───────────────────────────────────────────────────────────────────

# Port the HTTP server listens on. Default: 3001
PORT=3001

# ── Etherna gateway (optional) ───────────────────────────────────────────────
# Set ETHERNA_ENABLED=true to route all Swarm traffic through gateway.etherna.io
# instead of a local Bee node. When enabled, BEE_URL is ignored and the four
# variables below are required (except ETHERNA_GATEWAY_URL / ETHERNA_TOKEN_ENDPOINT
# / ETHERNA_SCOPES which have sensible defaults).
#
# POSTAGE_BATCH_ID above must point to a batch provisioned via credit.etherna.io.
# FEED_PRIVATE_KEY remains the same — feeds are signed client-side by us, not
# by Etherna's identity.

ETHERNA_ENABLED=false

# API key from sso.etherna.io/Identity/Account/Manage/ApiKeys (format: <id>.<secret>)
ETHERNA_API_KEY=

# Optional overrides (defaults shown — set by Etherna for all integrators):
# ETHERNA_CLIENT_ID=apiKeyClientId
# ETHERNA_GATEWAY_URL=https://gateway.etherna.io
# ETHERNA_TOKEN_ENDPOINT=https://sso.etherna.io/connect/token
# ETHERNA_SCOPES=openid profile offline_access ether_accounts role userApi.gateway

# ── Etherna per-user batch provisioning ──────────────────────────────────────
# When a creator publishes a website via the Etherna gateway and has no batch,
# the server provisions one on-demand from Etherna's /stamps endpoint and bills
# the platform account. Per-event deploys never trigger provisioning — they
# fall back to ETHERNA_PLATFORM_BATCH.

# Set to "false" to disable per-user provisioning entirely (websites then 402).
BATCH_PER_USER_AUTO_PROVISION=true

# Shared batch used as fallback for EVENT deploys when the creator has no batch.
# Provision once via credit.etherna.io and paste the 64-hex batch ID here.
ETHERNA_PLATFORM_BATCH=

# Defaults for newly-provisioned user batches.
# Depth 19 → ~1.4 GiB usable.
# TTL is in days and MAY be fractional. 1.1 = 26h 24min — gives ~2.4h headroom
# above a 24h test so a slightly-stale Gnosis block timestamp can't expire the
# batch mid-deploy. Raise to 30 for production.
ETHERNA_USER_BATCH_DEPTH=19
ETHERNA_USER_BATCH_TTL_DAYS=1.1

# Safety margin added on top of the live chainstate price before purchase (percent).
ETHERNA_USER_BATCH_MARGIN_PCT=25

# Hard cap on per-purchase BZZ committed (1 BZZ = 1e16 PLUR). Refuses to call
# /stamps if amountPerChunk × 2^depth exceeds this. Actual xDai debit is
# usually a fraction of BZZ committed (BZZ trades below xDai), so this is a
# strict upper bound. 0.5 BZZ at depth 19 covers ~1.1 days comfortably.
ETHERNA_PURCHASE_MAX_BZZ=0.5

# ---------------------------------------------------------------------------
# Agent commerce surface (/api/agent/*) — demo + MCP tooling (scripts/agent/*)
# ---------------------------------------------------------------------------
# The runtime /api/agent/* endpoints need NO new secret (the agent holds its own
# key; the server only verifies the on-chain draw). These vars configure the
# OUT-OF-SERVER agent tooling: the E2E demo and the MCP server.
#
# Shared:
#   ZERODEV_RPC is reused for the agent's gasless USDC draw (already set for POS).
#
# Demo (apps/server/scripts/agent/demo.ts):
# AGENT_API_BASE=http://localhost:3001
# AGENT_DEMO_USER_PK=0x...        # test user key; its Kernel must hold Arb-Sepolia test USDC
# AGENT_DEMO_EVENT_ID=...         # event with a USDC/direct-transfer series on 421614
# AGENT_DEMO_SERIES_ID=...
# AGENT_DEMO_AGENT_PK=0x...       # optional; a fresh agent key is generated if unset
#
# MCP server (apps/server/scripts/agent/mcp.ts) — the agent's identity + granted budget:
# WOCO_AGENT_PK=0x...             # the agent's OWN key (the granted spender)
# WOCO_AGENT_APPROVAL=...         # serialized spend-permission approval the user granted
# WOCO_AGENT_USER_KERNEL=0x...    # user Kernel: funds source + ticket recipient

# ── Sub-ENS names: label.woco.eth (#419/#440) ────────────────────────────────
# The L2 registrar (mints, permits, contenthash) and the L2Registry behind it,
# on SUB_ENS_CHAIN_ID (defaults to 421614, Arbitrum Sepolia). Both are OPTIONAL:
# unset, apps/server/src/lib/chain/sub-ens-contract.ts uses the built-in default
# for the chain — the same address apps/web/src/lib/auth/kernel-account.ts
# hardcodes, which test/sub-ens-address-pin.test.ts keeps true. Production
# currently SETS all three (see the deploy runbook); whether it should keep doing
# so once the default is guarded is an open call, not something this file decides.
#
# Left COMMENTED OUT on purpose, values shown. `SUB_ENS_REGISTRY_ADDRESS=` with
# nothing after it is NOT "unset" — dotenv and Docker `env_file` both make it the
# empty string, `??` keeps it, and every sub-ENS read then throws (loudly: 500 on
# the routes, `disabled` on the gateway). A wrong value is quieter and worse: it
# moves the server AND the ENS gateway, which reads the same accessor, away from
# the registry the frontend and the deployed contracts still point at. Move the
# env, the frontend constant and the deployment together or not at all.
# SUB_ENS_CHAIN_ID=421614
# SUB_ENS_REGISTRY_ADDRESS=0x6a5290df9B810d85Da3B97EE160C2B1f05eB9b22
# SUB_ENS_REGISTRAR_ADDRESS=0xD33C93E2E73A0C9C7683aaf6f4508F558A277816

# ── ENS CCIP-Read gateway (#419) ─────────────────────────────────────────────
# Serves GET /api/ens-gateway/v1/:sender/:data — the EIP-3668 endpoint Durin's
# L1Resolver calls to resolve *.woco.eth. Leave unset and the route answers 503;
# nothing else in the server is affected.

# The gateway's signing key. MUST be a NEW key, generated for this and nothing
# else — the server refuses to start the gateway if it derives the same address
# as WOCO_SPONSOR_PRIVATE_KEY. Reason: the sponsor holds funds and mints names,
# while this key sits behind a public unauthenticated GET, and a signature from
# it is authoritative resolution for EVERY organiser name under woco.eth.
# Generate: node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
# Its address must then be set as L1Resolver.signer() on L1.
ENS_GATEWAY_SIGNER_PRIVATE_KEY=

# Comma-separated L1Resolver addresses this gateway answers for. Required, and
# it is a pin, not a filter: the signature is bound to `target == sender`, so an
# unpinned sender means signing a resolution that some other resolver — possibly
# one an attacker deployed and pointed at this URL — would accept.
ENS_GATEWAY_RESOLVER_ADDRESSES=

# Optional. Only names strictly BELOW this parent are served; the apex itself is
# refused (its records live on L1, not in the L2 registry this gateway reads).
# ENS_GATEWAY_PARENT_NAME=woco.eth

# Optional. Signature validity in seconds (60..3600). Responses are HTTP-cached
# for 60s regardless, which must stay far below this.
# ENS_GATEWAY_TTL_SECONDS=600

# Second, INDEPENDENT L2 RPC endpoint. Strongly recommended before woco.eth
# points at our resolver (#465). The gateway signs whatever the RPC returns, and
# that signature IS resolution — a compromised or malicious provider can make
# this key sign a wrong contenthash for any subname, a silent site redirect that
# is valid for the TTL and indistinguishable on-chain from a real answer. With
# this set, both endpoints are read for every miss and the gateway refuses to
# sign (502) if they disagree. Must be a DIFFERENT ORIGIN from the primary
# (RPC_URL_<SUB_ENS_CHAIN_ID>): two API keys at one provider are one provider,
# and the server refuses to start the gateway rather than report a cross-check
# that proves nothing. Check /api/health -> ensGateway.crossCheck.
# ENS_GATEWAY_RPC_URL_2=

# The L2 chain + registry are NOT separate vars — they come from SUB_ENS_CHAIN_ID
# and SUB_ENS_REGISTRY_ADDRESS, so the gateway can only read the registry the
# platform actually mints into. The primary RPC endpoint likewise comes from
# RPC_URL_<chainId> (see the chain section above).
